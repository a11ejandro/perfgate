{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/a11ejandro/perfgate/main/schemas/run-result-v1.schema.json",
  "title": "Perfgate Run Result v1 (legacy)",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "fingerprint", "workloads"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "fingerprint": { "type": "object" },
    "workloads": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": false
}
